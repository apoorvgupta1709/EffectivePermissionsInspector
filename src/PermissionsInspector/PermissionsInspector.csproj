<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>PermissionsInspector</AssemblyName>
    <RootNamespace>PermissionsInspector</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>PermissionsInspector</PackageId>
    <Version>1.0.1</Version>
    <Title>Permissions Inspector</Title>
    <Authors>Apoorv Gupta</Authors>
    <Company>Apoorv Gupta</Company>
    <Description>Diagnose 'Why Can't John Edit This Record?' in Microsoft Dataverse across Security Roles, Team inheritance, BU depth, POA sharing, and Field-Level Security.</Description>
    <PackageProjectUrl>https://github.com/apoorvgupta1709/EffectivePermissionsInspector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/apoorvgupta1709/EffectivePermissionsInspector</RepositoryUrl>
    <PackageTags>XrmToolBox;XrmToolBoxPlugin;Dataverse;Dynamics365;PowerPlatform;Security;Permissions;POA;AccessRights</PackageTags>
    <PackageReleaseNotes>Release v1.0.1: Renamed tool to Permissions Inspector, added required IconUrl and optimized logo metadata for XrmToolBox Tool Library compliance.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageIconUrl>https://raw.githubusercontent.com/apoorvgupta1709/EffectivePermissionsInspector/main/icon.png</PackageIconUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Place output inside lib\net48\Plugins for XrmToolBox Tool Library -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddPluginFilesToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.7.71" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.59" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <!-- Package Icon and Readme -->
  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Target to place the compiled DLL and PDB inside lib\net48\Plugins\ for XrmToolBox -->
  <Target Name="AddPluginFilesToPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)">
        <PackagePath>lib\net48\Plugins</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')">
        <PackagePath>lib\net48\Plugins</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="DeployToXrmToolBox" AfterTargets="Build">
    <PropertyGroup>
      <XrmDownloadsDir>C:\Users\apoorv\Downloads\XrmToolbox</XrmDownloadsDir>
      <XrmDownloadsPluginsDir>C:\Users\apoorv\Downloads\XrmToolbox\Plugins</XrmDownloadsPluginsDir>
      <XrmAppDataPluginsDir>$(AppData)\MscrmTools\XrmToolBox\Plugins</XrmAppDataPluginsDir>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(TargetPath)" />
      <DeployFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(XrmDownloadsDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(XrmDownloadsPluginsDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(XrmAppDataPluginsDir)" Condition="Exists('$(XrmAppDataPluginsDir)')" ContinueOnError="true" />
  </Target>

</Project>
